# Copy to .env and adjust. On Vercel, add the same variable under Settings → Environment Variables.

# URL of the FastAPI backend (no trailing slash), e.g. https://diwali-api.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# Public address of the site, used in every share link (no trailing slash).
# Leave empty locally to use the current address; on Vercel set https://diwali-bazaar.vercel.app
VITE_PUBLIC_SITE_URL=
